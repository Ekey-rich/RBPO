{
  "info": {
    "name": "Лаба 5: JWT и сессии",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Запускай по порядку. Токены сохраняются автоматически. После шага 4 проверь в БД две строки для device_id='postman': REVOKED и ACTIVE. Регистрация создаёт ещё одну строку с device_id='registration'."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": "Student123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "oldRefresh",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Регистрация (создаёт USER)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"registration\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('username', 'student_' + Date.now());"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Вход: первая ACTIVE для устройства postman",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const pair = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', pair.accessToken);",
              "    pm.collectionVariables.set('refreshToken', pair.refreshToken);",
              "    pm.collectionVariables.set('oldRefresh', pair.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Экзамены с access",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/exams"
      }
    },
    {
      "name": "3. Обновление: USED и новая ACTIVE",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const pair = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', pair.accessToken);",
              "    pm.collectionVariables.set('refreshToken', pair.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Старый refresh повторно: 401 и REVOKED",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{oldRefresh}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Новый access продолжает работать",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": "{{baseUrl}}/api/exams"
      }
    }
  ]
}
